# RPG-OS Production Environment Configuration
# 
# CRITICAL: Never commit real credentials to version control.
# Copy this file to .env.local for development or configure via secret manager for production.
# 
# All variables are REQUIRED unless marked (optional).
# For production, use a proper secret management system (AWS Secrets Manager, HashiCorp Vault, etc.)

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Supabase project URL (e.g., https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key - safe for client-side
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key - server-side only, NEVER expose to client
SUPABASE_SECRET_KEY=

# Supabase service role key - server-side only, full admin access
# Used for admin operations, webhooks, background jobs
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# APPLICATION CONFIGURATION (Required)
# =============================================================================
# Application URL (e.g., https://app.rpg-os.com)
NEXT_PUBLIC_APP_URL=

# Environment: development | staging | production
NODE_ENV=production

# Enable/disable fake providers (MUST be false in production)
# Setting to true in production will cause startup failure
ALLOW_FAKE_PROVIDERS=false

# DEV-ONLY: "Acesso Imediato (Modo Demonstração)" no login + /dashboard sem sessão.
# Descomentar APENAS em dev/teste. Nunca definir em produção (default: fechado).
# ALLOW_DEMO_ACCESS="true"

# =============================================================================
# PAYMENT PROVIDER CONFIGURATION (Required for production payments)
# =============================================================================
# Active payment provider: STRIPE_CONNECT | ADYEN_FOR_PLATFORMS | SIBS
# FAKE is NOT allowed in production
PAYMENT_PROVIDER=STRIPE_CONNECT

# Stripe Connect (if using Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Adyen for Platforms (if using Adyen)
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_CLIENT_KEY=

# SIBS (if using SIBS)
SIBS_CLIENT_ID=
SIBS_CLIENT_SECRET=
SIBS_API_URL=
SIBS_TERMINAL_ID=

# =============================================================================
# SECRET BACKEND (Fase D2)
# =============================================================================
# Seletor server-side do cofre. Vazio/omitido = NotConfigured (fail-closed).
# Para ativar o Vault local: SECRET_BACKEND=vault (usa URL + service-role
# Supabase já configurados acima; nunca colocar segredos neste ficheiro).
SECRET_BACKEND=

# =============================================================================
# GOVERNMENT PROVIDER CONFIGURATION (Required for production government integrations)
# =============================================================================
# AT / e-Fatura (Autoridade Tributária)
# NOTA: não existe endpoint REST público. Os webservices oficiais são SOAP
# (fatcorews :723 para submissão, fatshare :725 para consulta) com mTLS
# (certificado de produtor assinado pela AT) + subutilizador WFA.
# Ver docs/FISCAL-AT-EFATURA-INTEGRATION-READINESS.md. Valores abaixo vazios
# de propósito: preencher apenas após adesão oficial como produtor de software.
AT_API_ENDPOINT=
AT_CLIENT_ID=
AT_CLIENT_SECRET=
AT_SOFTWARE_CERTIFICATE=
AT_CERTIFICATE_PASSWORD=
AT_ORGANIZATION_NIF=

# e-Fatura (same as AT but separate credentials if needed)
EFATURA_API_ENDPOINT=
EFATURA_CLIENT_ID=
EFATURA_CLIENT_SECRET=

# Segurança Social Direta
# NOTA: sem endpoint público verificado; preencher apenas após integração oficial.
SEGURANCA_SOCIAL_API_ENDPOINT=
SEGURANCA_SOCIAL_CLIENT_ID=
SEGURANCA_SOCIAL_CLIENT_SECRET=
SEGURANCA_SOCIAL_ORGANIZATION_NISS=
SEGURANCA_SOCIAL_CERTIFICATE=
SEGURANCA_SOCIAL_CERTIFICATE_PASSWORD=

# Autenticação.gov
AUTENTICACAO_GOV_API_ENDPOINT=https://autenticacao.gov.pt
AUTENTICACAO_GOV_CLIENT_ID=
AUTENTICACAO_GOV_CLIENT_SECRET=
AUTENTICACAO_GOV_CERTIFICATE=
AUTENTICACAO_GOV_CERTIFICATE_PASSWORD=

# Chave Móvel Digital (CMD)
CMD_API_ENDPOINT=
CMD_CLIENT_ID=
CMD_CLIENT_SECRET=

# Gov.pt
GOV_PT_API_ENDPOINT=
GOV_PT_CLIENT_ID=
GOV_PT_CLIENT_SECRET=

# =============================================================================
# SECURITY & CSRF (Required)
# =============================================================================
# CSRF secret for token generation (generate with: openssl rand -hex 32)
CSRF_SECRET=

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# =============================================================================
# RATE LIMITING (Optional - defaults provided)
# =============================================================================
# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Auth rate limit max requests (default: 10)
RATE_LIMIT_AUTH_MAX=10

# Payment rate limit max requests (default: 20)
RATE_LIMIT_PAYMENT_MAX=20

# Government rate limit max requests (default: 30)
RATE_LIMIT_GOVERNMENT_MAX=30

# Webhook rate limit max requests (default: 50)
RATE_LIMIT_WEBHOOK_MAX=50

# Read API rate limit max requests (default: 100)
RATE_LIMIT_READ_MAX=100

# Admin mutation rate limit max requests (default: 15)
RATE_LIMIT_ADMIN_MAX=15

# =============================================================================
# BODY SIZE LIMITS (Optional - defaults provided)
# =============================================================================
# Max body size for JSON APIs (bytes, default: 1MB)
BODY_LIMIT_JSON=1048576

# Max body size for government/fiscal (bytes, default: 5MB)
BODY_LIMIT_GOVERNMENT=5242880

# Max body size for webhooks (bytes, default: 500KB)
BODY_LIMIT_WEBHOOK=512000

# Max body size for file uploads (bytes, default: 25MB)
BODY_LIMIT_FILE=26214400

# Max body size for SAF-T exports (bytes, default: 50MB)
BODY_LIMIT_SAFT=52428800

# =============================================================================
# LOGGING & OBSERVABILITY (Optional)
# =============================================================================
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Enable structured JSON logging (default: true)
LOG_JSON=true

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Datadog API key for metrics (optional)
DATADOG_API_KEY=

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable e-Fatura workflow (default: true)
FEATURE_EFATURA=true

# Enable government integrations (default: true)
FEATURE_GOVERNMENT=true

# Enable payment processing (default: true)
FEATURE_PAYMENTS=true

# Enable marketing AI (default: false)
FEATURE_MARKETING_AI=false

# Enable reputation system (default: true)
FEATURE_REPUTACAO=true

# =============================================================================
# EMAIL / NOTIFICATIONS (Optional)
# =============================================================================
# SMTP configuration for transactional emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rpg-os.com

# =============================================================================
# STORAGE (Optional)
# =============================================================================
# S3-compatible storage for documents/backups
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =============================================================================
# DEVELOPMENT OVERRIDES (Only for local development)
# =============================================================================
# Uncomment and set for local development only
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NODE_ENV=development
# ALLOW_FAKE_PROVIDERS=true
# PAYMENT_PROVIDER=FAKE